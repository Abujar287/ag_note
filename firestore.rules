rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Helpers
    function isValidNote(data) {
      return data.keys().hasAll(['title', 'content', 'category', 'color', 'isPinned', 'createdAt', 'updatedAt', 'userId'])
        && data.keys().hasOnly(['title', 'content', 'category', 'color', 'isPinned', 'isLocked', 'password', 'createdAt', 'updatedAt', 'deletedAt', 'userId'])
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 100000
        && data.category is string && data.category.size() <= 50
        && data.color in ['blue', 'emerald', 'amber', 'rose', 'purple', 'cyan', 'slate']
        && data.isPinned is bool
        && data.userId == request.auth.uid;
    }

    function isValidPreferences(data) {
      return data.keys().hasOnly(['categories', 'theme', 'sortMode', 'viewMode'])
        && (data.categories == null || data.categories is list)
        && (data.theme == null || data.theme in ['light', 'dark']);
    }

    // 4. Match Blocks
    match /users/{userId} {
      allow read: if isOwner(userId);

      match /notes/{noteId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidNote(incoming())
          && incoming().updatedAt == request.time
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /settings/preferences {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPreferences(incoming());
      }
    }
  }
}
